# ============================================================
# AI-Based Cloud Observability System
# Environment configuration
#
# Copy this file to .env and fill in your own values.
# NEVER commit real credentials.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=ai-cloud-observability

# --- AWS (legacy placeholders; STEP 6 uses AWS_* / CLOUDWATCH_* below) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AWS CloudWatch integration (STEP 6) ---
# Disabled by default; never commit real credentials. Prefer IAM roles or
# environment-provided credentials when deployed to AWS.
# AWS_ENABLED=false
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# CLOUDWATCH_NAMESPACE=AWS/EC2
# CLOUDWATCH_DIMENSION_NAME=InstanceId
# CLOUDWATCH_DIMENSION_VALUE=
# CLOUDWATCH_LOOKBACK_MINUTES=10
# CLOUDWATCH_PERIOD=60

# --- Monitoring ---
PROMETHEUS_URL=

# --- Storage ---
DATABASE_URL=

# --- Blockchain audit trail ---
BLOCKCHAIN_ENABLED=

# --- Baseline engine (STEP 7) ---
# BASELINE_ROLLING_WINDOW=20
# BASELINE_STDDEV_MULTIPLIER=3

# --- Dataset pipeline (STEP 8) ---
# Chronological split ratios must sum to 1.0; version bumps are explicit.
# DATASET_TRAIN_RATIO=0.70
# DATASET_VALIDATION_RATIO=0.15
# DATASET_TEST_RATIO=0.15
# DATASET_VERSION=v1.0

# --- Distributed microservices (STEP 3: local defaults) ---
# Each service reads these plain environment variables (development defaults
# shown). Service URLs are never hard-coded in business logic.
# SERVICE_NAME=order-service
# SERVICE_VERSION=1.0.0
# APP_ENV=development
# PORT=8002
# PAYMENT_SERVICE_URL=http://localhost:8003
# NOTIFICATION_SERVICE_URL=http://localhost:8004
# REQUEST_TIMEOUT_SECONDS=5
# SIMULATED_LATENCY_MS=0

# --- Docker Compose overrides (STEP 4) ---
# Inside the observability-network, services resolve each other by Compose
# service name. Set these in the shell (or a local .env, never committed)
# before `docker compose up` to override the development defaults above.
# PAYMENT_SERVICE_URL=http://payment-service:8003
# NOTIFICATION_SERVICE_URL=http://notification-service:8004
# USER_SERVICE_URL=http://user-service:8001
# ORDER_SERVICE_URL=http://order-service:8002
# Per-service latency injection (milliseconds, 0 disables):
# ORDER_SIMULATED_LATENCY_MS=0
# PAYMENT_SIMULATED_LATENCY_MS=0
# NOTIFICATION_SIMULATED_LATENCY_MS=0